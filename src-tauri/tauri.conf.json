{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "clawshell",
	"version": "0.2.0",
	"identifier": "com.mehdikhody.clawshell",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "clawshell",
				"width": 400,
				"height": 780,
				"resizable": false,
				"maximizable": false,
				"decorations": false,
				"dragDropEnabled": false,
				"transparent": true,
				"shadow": false,
				"center": true,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDNkIyNDQyODNCQkVFNDYKUldSRzdydURRaVJyRE5JV2VEWi9STXpjeHJVekJOSmVnYVBxUjU3eGJzWnZ2T3FRYzd2cHVybWoK",
			"endpoints": ["https://github.com/mehdikhody/clawshell/releases/latest/download/latest.json"],
			"windows": {
				"installMode": "passive"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
